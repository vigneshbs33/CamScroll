<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="32dp"
    android:background="@color/bg_primary">

    <ImageView
        android:id="@+id/iv_page_icon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginBottom="32dp"
        android:tint="@color/text_primary" />

    <TextView
        android:id="@+id/tv_page_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="28sp"
        android:textColor="@color/text_primary"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="-0.02"
        android:lineSpacingMultiplier="1.2"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tv_page_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="15sp"
        android:textColor="@color/text_secondary"
        android:lineSpacingMultiplier="1.6"
        android:layout_marginBottom="32dp" />

    <!-- Permissions container (page 2) -->
    <LinearLayout
        android:id="@+id/perm_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_perm_camera"
            style="@style/Widget.CamScroll.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/perm_camera_title" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_perm_overlay"
            style="@style/Widget.CamScroll.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/perm_overlay_title" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_perm_notification"
            style="@style/Widget.CamScroll.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/perm_notification_title"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_perm_accessibility"
            style="@style/Widget.CamScroll.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/perm_accessibility_title" />
    </LinearLayout>

    <!-- Gesture picker container (page 3) -->
    <LinearLayout
        android:id="@+id/gesture_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Scroll gesture"
            style="@style/TextAppearance.CamScroll.Label"
            android:layout_marginBottom="12dp" />

        <Spinner
            android:id="@+id/spinner_scroll_gesture"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_spinner"
            android:padding="14dp" />
    </LinearLayout>

</LinearLayout>
