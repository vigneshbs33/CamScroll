<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Camera -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.front" android:required="true" />

    <!-- Foreground Service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />

    <!-- Overlay -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Notifications (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Wake lock to keep inference running while screen is on -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CamScroll">

        <!-- Onboarding (launcher) -->
        <activity
            android:name=".ui.OnboardingActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Main dashboard -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="false" />

        <!-- Trampoline: QS tile → start camera service (Android 14 requirement) -->
        <activity
            android:name=".ui.LaunchActivity"
            android:exported="false"
            android:theme="@style/Theme.CamScroll.Transparent"
            android:noHistory="true" />

        <!-- Calibration -->
        <activity
            android:name=".ui.CalibrationActivity"
            android:exported="false" />

        <!-- Settings -->
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false" />

        <!-- Core foreground service: camera + MediaPipe + gesture engine -->
        <service
            android:name=".service.FaceTrackingService"
            android:foregroundServiceType="camera"
            android:exported="false" />

        <!-- Accessibility service: dispatches scroll/tap/back actions -->
        <service
            android:name=".service.CamScrollAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Quick Settings tile -->
        <service
            android:name=".tile.CamScrollTileService"
            android:label="@string/tile_label"
            android:icon="@drawable/ic_tile"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

    </application>

</manifest>
